classDiagram
    direction TB

    %% Presentation Layer
    namespace turbo_tosec_cli {
        class cli {
            <<module>>
            +run_scan_mode(args, log_filename)$
            +run_parquet_mode(args)$
        }

        class CLIPresenter {
            +UniversalProgress pbar
            +ImportSession session
            +update_progress(current_bytes, total_bytes)
            +write_above_bar(msg)
        }
    }

    %% Core Engine Layer
    namespace turbo_tosec_core {
        class ImportSession {
            +int total_roms
            +int error_count
            +ingest(source, mode, callbacks...)
            -_run_direct_mode()
        }

        class DatabaseManager {
            +str db_path
            +DBConfig config
            +configure_threads(workers)
            +export_to_parquet(filepath)
        }
    }

    %% Relationships
    CLIPresenter ..> ImportSession : injects callbacks
    ImportSession o-- DatabaseManager : uses
    cli ..> CLIPresenter : instantiates
